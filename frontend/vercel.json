{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://durham-cartridges-tiles-investigate.trycloudflare.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://durham-cartridges-tiles-investigate.trycloudflare.com/health"
    },
    {
      "source": "/docs",
      "destination": "https://durham-cartridges-tiles-investigate.trycloudflare.com/docs"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
